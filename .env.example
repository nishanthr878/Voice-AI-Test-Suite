# Genesys Auth
GENESYS_CLIENT_ID=your_client_id_here
GENESYS_CLIENT_SECRET=your_client_secret_here
GENESYS_REGION=mypurecloud.com
GENESYS_QUEUE_ID=your_queue_id_here
GENESYS_CALLER_ID=+11234567890

# For mock testing only
# GENESYS_REGION=127.0.0.1:9000

# SIP + RTP
LOCAL_IP=127.0.0.1
YOUR_SIP_PORT=5060
RTP_LOCAL_PORT=10000

# Target voice AI number
VOICE_AI_PHONE_NUMBER=+1XXXXXXXXXX

# Groq API (get free key at console.groq.com)
GROQ_API_KEY=your_groq_key_here

# TTS
PIPER_MODEL=/app/models/en_US-lessac-medium.onnx

# Storage
LOG_DIR=/app/logs
TEST_CASES_DIR=/app/test_cases
CALL_CONNECT_TIMEOUT=30git