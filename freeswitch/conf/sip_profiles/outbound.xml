<profile name="outbound">
  <settings>
    <!-- FreeSWITCH listens for SIP on this port -->
    <param name="sip-port" value="5060"/>

    <!-- Bind to all interfaces so it can reach corporate network -->
    <param name="sip-ip" value="0.0.0.0"/>
    <param name="rtp-ip" value="0.0.0.0"/>

    <!-- RTP port range — must match what Docker exposes -->
    <param name="rtp-start-port" value="16384"/>
    <param name="rtp-end-port" value="16484"/>

    <!-- Codec order — PCMU first, matches Genesys default -->
    <param name="inbound-codec-prefs" value="PCMU,PCMA,G722"/>
    <param name="outbound-codec-prefs" value="PCMU,PCMA,G722"/>

    <!-- Don't register — we're only making outbound calls, not receiving -->
    <param name="register" value="false"/>

    <!-- How long to wait for the other side to answer -->
    <param name="rtp-timeout-sec" value="300"/>

    <!-- Logging -->
    <param name="log-auth-failures" value="true"/>
    <param name="log-level" value="info"/>
  </settings>

  <gateways>
    <!-- No gateway needed — dialing SIP URI directly -->
  </gateways>
</profile>