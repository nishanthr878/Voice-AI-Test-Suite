<configuration name="event_socket.conf" description="ESL Configuration">
  <settings>
    <!-- IP to listen on — 0.0.0.0 means accept from anywhere -->
    <!-- Since we're on host network, Python reaches this on 127.0.0.1:8021 -->
    <param name="listen-ip" value="0.0.0.0"/>
    <param name="listen-port" value="8021"/>

    <!-- Must match FREESWITCH_ESL_PASSWORD in your .env -->
    <param name="password" value="ClueCon"/>

    <!-- Events Python will receive -->
    <param name="apply-inbound-acl" value="loopback.auto"/>
  </settings>
</configuration>