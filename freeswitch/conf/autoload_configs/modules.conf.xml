<configuration name="modules.conf" description="Modules">
  <modules>
    <!-- SIP stack — core module for making/receiving SIP calls -->
    <load module="mod_sofia"/>

    <!-- ESL — lets Python control FreeSWITCH via TCP socket -->
    <load module="mod_event_socket"/>

    <!-- Audio formats -->
    <load module="mod_sndfile"/>
    <load module="mod_native_file"/>

    <!-- Audio streaming — pipes RTP audio to/from external process -->
    <load module="mod_shout"/>

    <!-- Call control applications: park, bridge, playback etc -->
    <load module="mod_dptools"/>

    <!-- Dialplan processing -->
    <load module="mod_dialplan_xml"/>

    <!-- Logging -->
    <load module="mod_logfile"/>
    <load module="mod_console"/>

    <!-- Tone generation — useful for testing audio pipeline -->
    <load module="mod_tone_stream"/>
  </modules>
</configuration>